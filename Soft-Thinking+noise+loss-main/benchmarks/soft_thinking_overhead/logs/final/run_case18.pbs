#!/bin/bash
#PBS -P PROJECT
#PBS -j oe
#PBS -q autox
#PBS -l walltime=01:00:00
source /path/to/miniconda3/etc/profile.d/conda.sh
conda activate soft_thinking
D=/path/to/infra_opt
cd $D
H=$(hostname); S=${SEED:-0}; O=$D/out18/seed$S; mkdir -p $O; echo "host=$H start=$(date)"
M=/path/to/SofT-GRPO-1.5B-checkpoint
DATA=/path/to/SofT-GRPO-master/Soft-Thinking+noise+loss-main/datasets/math500.json
C="python -u check_correct.py --model $M --data $DATA --num 500 --seed $S"
OFF="SOFT_MODE_PYBOOL=0 SOFT_BATCHED_BOOKKEEPING=0 SOFT_FAST_OUTPUT=0 SOFT_FAST_STATE=0 SOFT_EXACT_SAMPLER=0 SOFT_TRACE_NOGC=0 SOFT_EXACT_DEFER=0"
(unset PYTHONPATH; timeout 1500 $C --cuda_graph 0 --overlap 0 --tag orig --save $O/orig.jsonl) || echo "FAILED orig"
export PYTHONPATH=$D/python
timeout 1200 $C --cuda_graph 1 --overlap 1 --tag opt --save $O/opt.jsonl || echo "FAILED opt"
env $OFF timeout 1500 $C --cuda_graph 1 --overlap 1 --hold_prefill 1 --tag hold_off --save $O/hold_off.jsonl || echo "FAILED hold_off"
timeout 1200 $C --cuda_graph 1 --overlap 1 --hold_prefill 1 --tag hold_on --save $O/hold_on.jsonl || echo "FAILED hold_on"
echo "end=$(date)"
