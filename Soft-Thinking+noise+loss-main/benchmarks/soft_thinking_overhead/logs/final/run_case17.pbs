#!/bin/bash
#PBS -P PROJECT
#PBS -j oe
#PBS -l select=1:ngpus=1
#PBS -l walltime=00:50:00
source /path/to/miniconda3/etc/profile.d/conda.sh
conda activate soft_thinking
D=/path/to/infra_opt
cd $D
H=$(hostname); echo "host=$H start=$(date)"; ls /path/to/meta-llama/Llama-3.2-3B-Instruct/config.json
M=/path/to/meta-llama/Llama-3.2-3B-Instruct
export PYTHONPATH=$D/python
B="python -u bench_softthinking.py --model $M --out $D/results17_llama_$H.jsonl"
(unset PYTHONPATH; timeout 1500 $B --tag S_orig --mode soft --cuda_graph 0 --overlap 0) || echo "FAILED S_orig"
timeout 1200 $B --tag D_cg_ov --mode discrete --cuda_graph 1 --overlap 1 || echo "FAILED D_cg_ov"
timeout 1200 $B --tag S_final_cg --mode soft --cuda_graph 1 --overlap 0 || echo "FAILED S_final_cg"
timeout 1200 $B --tag S_final_cg_ov --mode soft --cuda_graph 1 --overlap 1 || echo "FAILED S_final_cg_ov"
echo "end=$(date)"
