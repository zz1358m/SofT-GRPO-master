[36m(TaskRunner pid=2696761)[0m OB = np.array([-3, -2, 1])
[36m(TaskRunner pid=2696761)[0m 
[36m(TaskRunner pid=2696761)[0m # Calculate the cross product of OA and OB
[36m(TaskRunner pid=2696761)[0m cross_product = np.cross(OA, OB)
[36m(TaskRunner pid=2696761)[0m 
[36m(TaskRunner pid=2696761)[0m # Calculate the magnitude of the cross product
[36m(TaskRunner pid=2696761)[0m magnitude = np.linalg.norm(cross_product)
[36m(TaskRunner pid=2696761)[0m 
