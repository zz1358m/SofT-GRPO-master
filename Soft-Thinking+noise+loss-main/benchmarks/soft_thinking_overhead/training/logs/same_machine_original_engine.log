[36m(TaskRunner pid=2727803)[0m         old_s, s = s, old_s - quotient * s
[36m(TaskRunner pid=2727803)[0m         old_t, t = t, old_t - quotient * t
[36m(TaskRunner pid=2727803)[0m 
[36m(TaskRunner pid=2727803)[0m     return old_r, old_s, old_t
[36m(TaskRunner pid=2727803)[0m 
