[36m(TaskRunner pid=2727803)[0m ```python
[36m(TaskRunner pid=2727803)[0m def extended_gcd(a, b):
[36m(TaskRunner pid=2727803)[0m     """Extended Euclidean Algorithm that returns the gcd of a and b,
[36m(TaskRunner pid=2727803)[0m     and the coefficients of Bézout's identity"""
[36m(TaskRunner pid=2727803)[0m     s, old_s = 0, 1
[36m(TaskRunner pid=2727803)[0m     t, old_t = 1, 0
[36m(TaskRunner pid=2727803)[0m     r, old_r = b, a
[36m(TaskRunner pid=2727803)[0m 
[36m(TaskRunner pid=2727803)[0m     while r != 0:
