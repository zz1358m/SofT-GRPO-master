[36m(TaskRunner pid=2727803)[0m OB = np.array([-3, -2, 1])
[36m(TaskRunner pid=2727803)[0m 
[36m(TaskRunner pid=2727803)[0m # Compute the cross product of OA and OB
[36m(TaskRunner pid=2727803)[0m cross_product = np.cross(OA, OB)
[36m(TaskRunner pid=2727803)[0m 
[36m(TaskRunner pid=2727803)[0m # Compute the magnitude of the cross product
[36m(TaskRunner pid=2727803)[0m magnitude = np.linalg.norm(cross_product)
[36m(TaskRunner pid=2727803)[0m 
[36m(TaskRunner pid=2727803)[0m # Compute the area of the triangle
[36m(TaskRunner pid=2727803)[0m area = 0.5 * magnitude
[36m(TaskRunner pid=2727803)[0m print(area)
