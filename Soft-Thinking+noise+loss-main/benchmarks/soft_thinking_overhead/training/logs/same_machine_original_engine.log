[36m(TaskRunner pid=2727803)[0m ```python
[36m(TaskRunner pid=2727803)[0m from sympy import symbols, Eq, solve
[36m(TaskRunner pid=2727803)[0m 
[36m(TaskRunner pid=2727803)[0m # Define the variables
[36m(TaskRunner pid=2727803)[0m s, t = symbols('s t')
[36m(TaskRunner pid=2727803)[0m 
[36m(TaskRunner pid=2727803)[0m # Define the equations based on the given information
[36m(TaskRunner pid=2727803)[0m eq1 = Eq(9, s * (4 - t / 60))
[36m(TaskRunner pid=2727803)[0m eq2 = Eq(9, (s + 2) * (2.4 - t / 60))
[36m(TaskRunner pid=2727803)[0m 
[36m(TaskRunner pid=2727803)[0m # Solve the equations
