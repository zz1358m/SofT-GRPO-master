[36m(TaskRunner pid=3347742)[0m # Function to compute the modular inverse using Extended Euclidean Algorithm
[36m(TaskRunner pid=3347742)[0m def modular_inverse(a, m):
[36m(TaskRunner pid=3347742)[0m     m0, x0, x1 = m, 0, 1
[36m(TaskRunner pid=3347742)[0m     if m == 1:
[36m(TaskRunner pid=3347742)[0m         return 0
[36m(TaskRunner pid=3347742)[0m     while a > 1:
[36m(TaskRunner pid=3347742)[0m         # q is quotient
[36m(TaskRunner pid=3347742)[0m         q = a // m
[36m(TaskRunner pid=3347742)[0m         m, a = a % m, m
[36m(TaskRunner pid=3347742)[0m         x0, x1 = x1 - q * x0, x0
[36m(TaskRunner pid=3347742)[0m     # Make x1 positive
[36m(TaskRunner pid=3347742)[0m     if x1 < 0:
[36m(TaskRunner pid=3347742)[0m         x1 += m0
[36m(TaskRunner pid=3347742)[0m     return x1
[36m(TaskRunner pid=3347742)[0m 
[36m(TaskRunner pid=3347742)[0m # Compute the modular inverse of 997 modulo 1000
[36m(TaskRunner pid=3347742)[0m inverse = modular_inverse(997, 1000)
