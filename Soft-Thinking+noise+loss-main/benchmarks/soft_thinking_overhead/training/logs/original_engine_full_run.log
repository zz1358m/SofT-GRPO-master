[36m(TaskRunner pid=3347742)[0m     gcd, x1, y1 = extended_gcd(b % a, a)
[36m(TaskRunner pid=3347742)[0m     x = y1 - (b // a) * x1
[36m(TaskRunner pid=3347742)[0m     y = x1
[36m(TaskRunner pid=3347742)[0m     return gcd, x, y
[36m(TaskRunner pid=3347742)[0m 
